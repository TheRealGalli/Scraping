# Google Sheet Configuration
SPREADSHEET_ID=your_google_sheet_id_here
SHEET_NAME=Italy

# Google API Credentials & Project
GOOGLE_API_KEY=your_google_places_and_custom_search_api_key
CUSTOM_SEARCH_ENGINE_ID=your_custom_search_cx_id
GCP_PROJECT=your_gcp_project_id
GCP_LOCATION=europe-west1

# Gemini & Grounding Settings
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
ENABLE_GEMINI_GROUNDING=True

# Google Workspace SMTP Sender Settings
WORKSPACE_EMAIL=info@yourdomain.com
WORKSPACE_APP_PASSWORD=abcdefghijklmnop
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAX_DAILY_EMAILS=50
SEND_DELAY_MIN_SEC=900.0
SEND_DELAY_MAX_SEC=1200.0

# Timezone & Scraping Settings
TIMEZONE=Europe/Rome
NIGHT_START_HOUR=22
NIGHT_END_HOUR=6
HTTP_TIMEOUT=4.0
MAX_PLACES_PER_RUN=20
SLEEP_BETWEEN_CALLS=0.5
