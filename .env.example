# Google Sheet Configuration
SPREADSHEET_ID=your_google_sheet_id_here
SHEET_NAME=Italy

# Google API Credentials & Project
GOOGLE_API_KEY=your_google_places_and_custom_search_api_key
CUSTOM_SEARCH_ENGINE_ID=your_custom_search_cx_id
GCP_PROJECT=your_gcp_project_id
GCP_LOCATION=europe-west1

# Gemini & Grounding Settings
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
ENABLE_GEMINI_GROUNDING=False

# Google Workspace SMTP Sender Settings
WORKSPACE_EMAIL=info@yourdomain.com
WORKSPACE_APP_PASSWORD=abcdefghijklmnop
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAX_DAILY_EMAILS=50

# Six-campaign sender: never enable live mode before migration and owned-inbox tests.
SENDING_ENABLED=False
SENDER_MODE=dry_run
SENDER_CRON_SECRET=replace_with_a_dedicated_random_secret
TEST_RECIPIENTS=your_owned_test_address@example.it
FIRESTORE_DATABASE=(default)
CAMPAIGN_NAMESPACE=campaign_sender_v1
GLOBAL_DAILY_LIMIT=50
GLOBAL_INTERVAL_SECONDS=120
CONTACT_COOLDOWN_DAYS=30
CONTACT_WINDOW_DAYS=90
CONTACT_WINDOW_MAX_SENDS=2
CAMPAIGN_LEASE_SECONDS=120
SENDER_START_TIME=08:30
SENDER_END_TIME=18:30
CAMPAIGN_SHEET_MAX_AGE_MINUTES=30

# Timezone & Scraping Settings
TIMEZONE=Europe/Rome
NIGHT_START_HOUR=22
NIGHT_END_HOUR=6
HTTP_TIMEOUT=4.0
MAX_PLACES_PER_RUN=20
SLEEP_BETWEEN_CALLS=0.5
